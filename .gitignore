.gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
venv/
env/

# Environment
.env
.env.local

# Database
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test files
test/
*-test/

# Coverage / pytest artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Archives (never commit secrets bundled into a tarball, e.g. ~/.license data)
*.tar.gz
*.tar
*.tgz

# License activation secrets (SecureStorage in app/core/license_client.py).
# Default LICENSE_STORAGE_DIR is ~/.license, outside the repo, so these
# should never appear here — this is a guard against an accidental local
# override/copy, not a normal generated-artifact path. See item 1.2 in
# docs/SECURITY_REMEDIATION_CHECKLIST.md (license_data.tar.gz history leak).
.license/
.license.key
.license.dat
.state.dat
license_data*

# Node.js / Frontend
node_modules/
dist/
build/
*.local
.vite/

# Lock files (keep package.json, ignore lock files optionally)
# Uncomment the line below if you want to ignore lock files
# package-lock.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

#claude

CLAUDE.md


.vevn/
.venv
dist_build/
*.zip
*.pdf
#docs
documents/
documents

# TLS (self-signed, generated per-deployment — see docs/DEPLOYMENT_GUIDE.md)
traefik/certs/*.key
traefik/certs/*.crt

# Stray env backups (never commit real secrets)
.env.bak*
.env.*.bak


