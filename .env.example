# Netease Backend Configuration
# Copy this file to .env and edit as needed before starting the server.

# PostgreSQL connection string
# If using docker-compose.yml: keep the defaults below
DATABASE_URL=postgresql://netease:1234@localhost/netease_db

# Secret key for JWT token signing — CHANGE THIS in any shared/production deployment
SECRET_KEY=change-this-to-a-random-32-character-string

# Server bind settings
HOST=0.0.0.0
PORT=8000
