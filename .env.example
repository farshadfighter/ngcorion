# Netease Backend Configuration
# Copy this file to .env and edit as needed before starting the server.

# PostgreSQL connection string
# If using docker-compose.yml: keep the defaults below
DATABASE_URL=postgresql://netease:1234@localhost/netease_db

# Secret key for JWT token signing — CHANGE THIS in any shared/production deployment
SECRET_KEY=change-this-to-a-random-32-character-string

# Web sessions: a session unused for this many minutes is ended (its token is
# revoked); the UI also signs out after this long without keyboard or mouse
# input. A token lasts ACCESS_TOKEN_EXPIRE_MINUTES at most.
SESSION_IDLE_TIMEOUT_MINUTES=30
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# Notice on the login page before anyone signs in. Empty: the built-in
# bilingual notice ("Authorised use only ... every action is recorded").
LOGIN_BANNER=

# Server bind settings
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# CORS — cross-origin browser access
# ---------------------------------------------------------------------------
# LEAVE THIS EMPTY unless a browser app served from a DIFFERENT origin has to
# call this API. Empty is not a downgrade — it is the correct setting for the
# standard deployment:
#   * production: this app serves the frontend itself (front/dist) and the
#     frontend calls the API with a relative URL, so requests are same-origin
#     and CORS never applies;
#   * development: the Vite dev server proxies /api and /auth to the backend
#     (front/vite.config.js), so those are same-origin too.
#
# Set it only for a separately-hosted frontend, listing each exact origin
# (scheme + host + port, no trailing slash, no path). JSON list or comma
# separated, both accepted:
#   BACKEND_CORS_ORIGINS=["https://ngcorion.example.com"]
#   BACKEND_CORS_ORIGINS=https://ngcorion.example.com,http://localhost:5173
#
# "*" is REJECTED at startup and the app will not boot with it. A wildcard
# cannot be combined with credentialed requests: the server reflects the
# caller's own Origin back, so any site an operator visits could drive this API
# as that logged-in operator. List real origins instead.
#BACKEND_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# License Server
# ---------------------------------------------------------------------------
# Nothing to set: the license server is always https://lic.ngcorion.com,
# built into the code with its signing key (app/core/license_keys.py). This
# host must resolve lic.ngcorion.com and reach it on port 443.
# (LICENSE_SERVER_URL / LICENSE_SERVER_CA_BUNDLE from older releases are
# ignored, with a warning in the log; remove them.)

# --- The two values below are NOT read by this stack ----------------------
# They belong to the license server host (deploy/.env.license.example) and are
# repeated here only so a deployment keeps both halves of the pair in one place.
# Copy them to the license host's .env; changing them here has no effect.
# Generate the key with: openssl rand -hex 32
LICENSE_SERVER_SECRET_KEY=change-this-in-production
# Password of the first account of the license admin console (it must be
# changed at the first sign-in; later accounts are made in the console).
LICENSE_ADMIN_PASSWORD=change-this-in-production

# Where the activated license (key + organization token) is stored, encrypted.
# This value applies to a bare-metal / local run only. Under docker-compose the
# backend runs as UID 10001 (no /root access) and the compose file sets
# LICENSE_STORAGE_DIR=/var/lib/ngcorion/license explicitly, matching the
# license_client_data volume mount — the container never reads this file.
LICENSE_STORAGE_DIR=~/.license

# HTTP behaviour for calls to the license server. Defaults shown; raise the
# timeouts if the license server sits behind a slow WAN link.
#LICENSE_CONNECT_TIMEOUT=5
#LICENSE_READ_TIMEOUT=10
#LICENSE_HTTP_RETRIES=3
# Without contact with the license server NGCorion keeps the license's plan for
# 48 hours, then runs as a pilot license (5 assets) for 30 days, then locks; the
# plan returns as soon as the server is reached. Fixed in the code, not set here.
# Heartbeat cadence. A *failed* heartbeat is retried with backoff starting at
# RETRY_SECONDS (doubling, capped at MAX_RETRY_SECONDS) instead of waiting a
# whole interval, so a short outage is recovered from in a minute rather than
# an hour.
#LICENSE_HEARTBEAT_INTERVAL_SECONDS=3600
#LICENSE_HEARTBEAT_RETRY_SECONDS=60
#LICENSE_HEARTBEAT_MAX_RETRY_SECONDS=900
# Cache the last validated license state (encrypted, in LICENSE_STORAGE_DIR) so
# restarting while the license server is down resumes where it was (own plan or
# offline pilot) instead of refusing every request. Set to false to disable.
#LICENSE_STATE_CACHE_ENABLED=true

# Email for "forgot password" codes. Set the mail server in the web interface
# (System Configuration > SMTP), which alerts and reports use as well; the
# values below are only a fallback for installations that set them here before.
# Without any mail server no code is sent (and none is ever written to the log).
# NOTE: SMTP_FROM_EMAIL should match SMTP_USERNAME (the authenticated mailbox), or the
# mail server may reject the message as a spoofed sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NGcorion

# Minutes a password-reset OTP code stays valid, and how many wrong attempts are allowed.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# SSH host-key verification (audit + hardening connections to managed devices)
# See docs/SSH_HOST_KEY_VERIFICATION.md
# ---------------------------------------------------------------------------
# tofu   (default) Trust on first use: the first connection to a device pins its
#                  host key (logged with the fingerprint) and every later
#                  connection must present that same key. Existing devices keep
#                  working with no manual setup; a changed/spoofed key is
#                  refused.
# strict           Only devices already present in the known-hosts store can be
#                  reached; nothing is pinned automatically. Switch to this once
#                  the fleet's keys have been pinned and verified.
# There is no "off": a legitimately reinstalled device is handled by removing
# that one host's entry (ssh-keygen -R), not by disabling verification.
#SSH_HOST_KEY_POLICY=tofu
#
# Where pinned keys are stored (OpenSSH known_hosts format). Empty = auto:
# /etc/ngcorion/known_hosts when writable (bind-mounted in docker-compose.yml, so
# pins survive container recreation), otherwise ~/.ngcorion/known_hosts.
#SSH_KNOWN_HOSTS_FILE=

# ---------------------------------------------------------------------------
# CVE database
# ---------------------------------------------------------------------------
# The CVE page matches assets against a local copy of every published CVE
# (NVD), with CISA KEV and FIRST EPSS. Load it once from the CVE page, then
# update it online (daily automatic update is optional) or with signed .ngcve
# packages on servers without internet. The NVD API key is set on that page
# (stored encrypted), not here.
#
# Public key (base64 Ed25519) whose signature this server accepts on the
# snapshot shipped with a release (data/cve/bundle.ngcve). To produce one: on
# an NGCorion with internet, update the database, then CVE > Database >
# Create package > The whole database; copy that server's key from
# CVE > Database > Trusted keys > Copy public key into this variable on the
# servers that receive the snapshot.
#CVE_RELEASE_PUBLIC_KEY=
#
# Internal mirrors of the public feeds (defaults are the official URLs).
#NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
#CVE_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
#CVE_EPSS_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
#
# Largest update package accepted for upload, in MB (default 2048).
#CVE_MAX_PACKAGE_MB=2048

# ---------------------------------------------------------------------------
# docker-compose only (substituted into docker-compose.yml, not read by the app)
# ---------------------------------------------------------------------------
# Application database password. If unset, docker-compose.yml falls back to
# the development value 1234 (kept temporarily) - set a real one for any
# production deployment. Generate one with `openssl rand -hex 24`.
#
# Postgres only applies this when its data volume is created. To change it on
# an existing deployment, change it in the database first and then here:
#   docker exec -it postgres psql -U netease -d netease_db \
#     -c "ALTER USER netease WITH PASSWORD '<new-password>';"
#POSTGRES_PASSWORD=<long-random-value>
#
# Interface Traefik's management port (8080) is published on. Defaults to
# 127.0.0.1, i.e. reachable only from the host itself. Traefik's insecure API is
# disabled in docker-compose.yml, so nothing listens there unless you switch it
# back on for debugging — in which case this keeps it off the network. Set it to
# an admin-only interface if you genuinely need remote access; never 0.0.0.0.
#TRAEFIK_BIND_ADDR=127.0.0.1
#
# The license database / admin / Redis variables moved out with the services
# themselves: see deploy/.env.license.example on the license server host.
