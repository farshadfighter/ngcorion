        { "name": "webauth_used", "type": "bool", "required": true, "label": "Web Authentication Used", "default": false },
        {
          "name": "banner_webauth_text",
          "type": "text_multiline",
          "required": true,
          "label": "Webauth Banner Text",
          "depends_on": { "field": "webauth_used", "equals": true }
        }
      ]
    },
    {
      "control_id": "1.4.1",
      "title": "Set enable secret",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
