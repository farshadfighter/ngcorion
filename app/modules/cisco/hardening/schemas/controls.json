          "name": "local_users",
          "type": "repeater",
          "required": true,
          "label": "Local Users",
          "item_schema": {
            "type": "object",
            "fields": [
              { "name": "username", "type": "string", "required": true, "label": "Username" },
              { "name": "privilege", "type": "int", "required": true, "label": "Privilege Level", "default": 15, "min": 1, "max": 15 },
              { "name": "secret_mode", "type": "enum", "required": true, "label": "Secret Mode", "options": ["user_provided", "auto_generate"], "default": "auto_generate" },
              {
                "name": "secret_value",
                "type": "secret",
                "required": true,
                "label": "Secret/Password",
                "depends_on": { "field": "secret_mode", "equals": "user_provided" }
              }
