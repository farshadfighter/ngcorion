        { "name": "enable_secret_mode", "type": "enum", "required": true, "label": "Secret Mode", "options": ["user_provided", "auto_generate"], "default": "auto_generate" },
        {
          "name": "enable_secret_value",
          "type": "secret",
          "required": true,
          "label": "Enable Secret",
          "depends_on": { "field": "enable_secret_mode", "equals": "user_provided" }
        }
      ]
    },
    {
      "control_id": "1.4.2",
      "title": "Enable service password-encryption",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
