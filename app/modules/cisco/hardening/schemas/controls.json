{
  "schema_version": "1.0",
  "device_type": "cisco",
  "profile": "CIS_Cisco_ControlBased_UI",
  "ui_mode": "control_by_control",
  "defaults": {
    "state": "AUDIT",
    "show_preview_config": true,
    "auto_fill_from_previous_inputs": true
  },
  "shared_fields": {
    "device_role": {
      "type": "enum",
      "label": "Device Role",
      "options": ["branch", "dc", "core", "edge", "access"],
      "required": false
    },
    "external_interface": {
      "type": "string",
      "label": "External (WAN/Internet) Interface",
      "required": false,
      "hint": "e.g., GigabitEthernet0/0"
    },
    "mgmt_source_interface": {
      "type": "string",
      "label": "Management Source Interface",
      "required": false,
      "hint": "e.g., Loopback0"
    },
    "vty_lines": {
      "type": "string",
      "label": "VTY Lines Range",
      "required": false,
      "default": "0 4",
      "hint": "e.g., '0 4' or '0 15'"
    }
  },
  "controls": [
    {
      "control_id": "1.1.1",
      "title": "Enable aaa new-model",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": []
    },
    {
      "control_id": "1.1.2",
      "title": "Enable aaa authentication login",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        {
          "name": "login_method_list_name",
          "type": "string",
          "required": true,
          "label": "Method List Name",
          "default": "DEFAULT"
        },
        {
          "name": "login_auth_order",
          "type": "ordered_multi_enum",
          "required": true,
          "label": "Authentication Order",
          "options": ["tacacs", "radius", "local"],
          "hint": "Order matters. Example: tacacs -> local"
        },
        {
          "name": "aaa_servers",
          "type": "repeater",
          "required": true,
          "label": "AAA Servers",
          "depends_on": {
            "any_in": ["login_auth_order"],
            "values_include_any": ["tacacs", "radius"]
          },
          "item_schema": {
            "type": "object",
            "fields": [
              { "name": "type", "type": "enum", "required": true, "label": "Server Type", "options": ["tacacs", "radius"] },
              { "name": "ip_or_fqdn", "type": "string", "required": true, "label": "IP or Hostname" },
              { "name": "secret", "type": "secret", "required": true, "label": "Shared Secret" },
              { "name": "port", "type": "int", "required": false, "label": "Port", "min": 1, "max": 65535 },
              { "name": "vrf", "type": "string", "required": false, "label": "VRF Name" },
              { "name": "source_interface", "type": "string", "required": false, "label": "Source Interface", "hint": "e.g., Loopback0" }
            ]
          }
        }
      ]
    },
    {
      "control_id": "1.1.3",
      "title": "Enable aaa authentication enable default",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        {
          "name": "enable_auth_order",
          "type": "ordered_multi_enum",
          "required": true,
          "label": "Enable Authentication Order",
          "options": ["tacacs", "radius", "local"]
        }
      ]
    },
    {
      "control_id": "1.1.4",
      "title": "Set login authentication for line vty",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "vty_lines", "type": "ref", "ref": "shared_fields.vty_lines", "required": true, "label": "VTY Lines" },
        { "name": "vty_login_method_list_name", "type": "string", "required": true, "label": "Method List Name", "default": "DEFAULT" }
      ]
    },
    {
      "control_id": "1.1.5",
      "title": "Set login authentication for ip http",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "http_mgmt_enabled", "type": "bool", "required": true, "label": "HTTP Management Enabled", "default": false },
        {
          "name": "http_auth_method_list_name",
          "type": "string",
          "required": true,
          "label": "HTTP Auth Method List",
          "depends_on": { "field": "http_mgmt_enabled", "equals": true }
        }
      ]
    },
    {
      "control_id": "1.1.6",
      "title": "aaa accounting commands 15",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "acct_method_list_name", "type": "string", "required": true, "label": "Method List Name", "default": "DEFAULT" },
        { "name": "acct_destination", "type": "enum", "required": true, "label": "Accounting Destination", "options": ["tacacs", "radius"] },
        { "name": "privilege_level", "type": "int", "required": true, "label": "Privilege Level", "default": 15, "min": 1, "max": 15 }
      ]
    },
    {
      "control_id": "1.1.7",
      "title": "aaa accounting connection",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "acct_method_list_name", "type": "string", "required": true, "label": "Method List Name", "default": "DEFAULT" },
        { "name": "acct_destination", "type": "enum", "required": true, "label": "Accounting Destination", "options": ["tacacs", "radius"] }
      ]
    },
    {
      "control_id": "1.1.8",
      "title": "aaa accounting exec",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "acct_method_list_name", "type": "string", "required": true, "label": "Method List Name", "default": "DEFAULT" },
        { "name": "acct_destination", "type": "enum", "required": true, "label": "Accounting Destination", "options": ["tacacs", "radius"] }
      ]
    },
    {
      "control_id": "1.1.9",
      "title": "aaa accounting network",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "acct_method_list_name", "type": "string", "required": true, "label": "Method List Name", "default": "DEFAULT" },
        { "name": "acct_destination", "type": "enum", "required": true, "label": "Accounting Destination", "options": ["tacacs", "radius"] }
      ]
    },
    {
      "control_id": "1.1.10",
      "title": "aaa accounting system",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "acct_method_list_name", "type": "string", "required": true, "label": "Method List Name", "default": "DEFAULT" },
        { "name": "acct_destination", "type": "enum", "required": true, "label": "Accounting Destination", "options": ["tacacs", "radius"] }
      ]
    },
    {
      "control_id": "1.2.2",
      "title": "Set transport input ssh for line vty",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "vty_lines", "type": "ref", "ref": "shared_fields.vty_lines", "required": true, "label": "VTY Lines" }
      ]
    },
    {
      "control_id": "1.2.4",
      "title": "Create access-list for use with line vty",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "vty_acl_name_or_number", "type": "string", "required": true, "label": "ACL Name/Number", "default": "MGMT_VTY" },
        {
          "name": "mgmt_allowed_sources",
          "type": "list_string",
          "required": true,
          "label": "Allowed Management Sources",
          "item_validation": { "type": "cidr_or_ip" },
          "hint": "Enter IP addresses or CIDR ranges (e.g., 10.0.0.0/24)"
        }
      ]
    },
    {
      "control_id": "1.2.5",
      "title": "Set access-class for line vty",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "vty_lines", "type": "ref", "ref": "shared_fields.vty_lines", "required": true, "label": "VTY Lines" },
        { "name": "vty_acl_name_or_number", "type": "string", "required": true, "label": "ACL Name/Number", "default": "MGMT_VTY" },
        { "name": "direction", "type": "enum", "required": true, "label": "Direction", "options": ["in", "out"], "default": "in" }
      ]
    },
    {
      "control_id": "1.2.6",
      "title": "Set exec-timeout <= 10 for line aux 0",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "aux_timeout_minutes", "type": "int", "required": true, "label": "Timeout (minutes)", "default": 10, "min": 1, "max": 10 }
      ]
    },
    {
      "control_id": "1.2.7",
      "title": "Set exec-timeout <= 10 for line console 0",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "console_timeout_minutes", "type": "int", "required": true, "label": "Timeout (minutes)", "default": 10, "min": 1, "max": 10 }
      ]
    },
    {
      "control_id": "1.2.8",
      "title": "Set exec-timeout <= 10 for line vty",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        { "name": "vty_lines", "type": "ref", "ref": "shared_fields.vty_lines", "required": true, "label": "VTY Lines" },
        { "name": "vty_timeout_minutes", "type": "int", "required": true, "label": "Timeout (minutes)", "default": 10, "min": 1, "max": 10 }
      ]
    },
    {
      "control_id": "1.2.9",
      "title": "Set transport input none for line aux 0",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": []
