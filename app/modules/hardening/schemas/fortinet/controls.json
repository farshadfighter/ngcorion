{
  "schema_version": "1.0",
  "device_type": "fortinet",
  "profile": "CIS_FortiGate_ControlBased_UI",
  "ui_mode": "control_by_control",
  "defaults": {
    "state": "AUDIT",
    "show_preview_config": true,
    "auto_fill_from_previous_inputs": true
  },
  "shared_fields": {
    "vdom": {
      "type": "string",
      "label": "VDOM Name",
      "required": false,
      "hint": "Leave empty for global context, or specify VDOM name"
    },
    "wan_interface": {
      "type": "string",
      "label": "WAN Interface",
      "required": false,
      "hint": "e.g., wan1, port1"
    },
    "mgmt_interface": {
      "type": "string",
      "label": "Management Interface",
      "required": false,
      "hint": "e.g., port1, mgmt"
    }
  },
  "controls": [
    {
      "control_id": "FG-BL-001",
      "title": "Enable Admin HTTPS",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [],
      "check_number": "FG-BL-001"
    },
    {
      "control_id": "FG-BL-002",
      "title": "Disable Admin HTTP",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
