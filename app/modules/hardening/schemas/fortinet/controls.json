          "max": 480,
          "hint": "Recommended: 10 minutes or less"
        }
      ],
      "check_number": "FG-BL-004"
    },
    {
      "control_id": "FG-BL-005",
      "title": "Disable TLS 1.0/1.1 for Admin HTTPS",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [],
      "check_number": "FG-BL-005"
