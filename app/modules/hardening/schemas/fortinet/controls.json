      "title": "Disable Admin Telnet",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [],
      "check_number": "FG-BL-003"
    },
    {
      "control_id": "FG-BL-004",
      "title": "Set Admin Idle Timeout",
      "state_options": ["SKIP", "AUDIT", "APPLY"],
      "inputs": [
        {
          "name": "admin_timeout",
          "type": "int",
          "required": false,
          "label": "Timeout (minutes)",
          "default": 10,
