<?xml version="1.0" encoding="UTF-8"?>
<!--
  NGCorion virtual appliance descriptor. appliance/make-ova.sh fills in the
  @...@ placeholders. The ProductSection properties appear on vCenter's
  "Deploy OVF Template" screen; when host name and admin password are
  given, the appliance configures itself on first boot
  (appliance/ngcorion_appliance/ovf.py), otherwise it asks on its console.
-->
<Envelope xmlns="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:cim="http://schemas.dmtf.org/wbem/wscim/1/common"
          xmlns:ovf="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:rasd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_ResourceAllocationSettingData"
          xmlns:vmw="http://www.vmware.com/schema/ovf"
          xmlns:vssd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_VirtualSystemSettingData"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <References>
    <File ovf:href="@VMDK_NAME@" ovf:id="file1" ovf:size="@VMDK_SIZE@"/>
  </References>
  <DiskSection>
    <Info>Virtual disk information</Info>
    <Disk ovf:capacity="@CAPACITY@" ovf:capacityAllocationUnits="byte" ovf:diskId="vmdisk1" ovf:fileRef="file1"
          ovf:format="http://www.vmware.com/interfaces/specifications/vmdk.html#streamOptimized"/>
  </DiskSection>
  <NetworkSection>
    <Info>The list of logical networks</Info>
    <Network ovf:name="Management">
      <Description>The network NGCorion is managed from and reaches the audited devices on</Description>
    </Network>
  </NetworkSection>
  <VirtualSystem ovf:id="NGCorion-@VERSION@">
    <Info>NGCorion security audit and hardening appliance</Info>
    <Name>NGCorion-@VERSION@</Name>
    <OperatingSystemSection ovf:id="94" vmw:osType="ubuntu64Guest">
      <Info>The operating system installed</Info>
      <Description>Ubuntu Linux (64-bit)</Description>
    </OperatingSystemSection>
    <ProductSection ovf:required="false">
      <Info>NGCorion first-boot settings</Info>
      <Product>NGCorion</Product>
      <Vendor>NGCorion</Vendor>
      <Version>@VERSION@</Version>
      <FullVersion>@VERSION@</FullVersion>
      <Category>Appliance</Category>
      <Property ovf:key="ngcorion.hostname" ovf:type="string" ovf:userConfigurable="true" ovf:value="ngcorion">
        <Label>Host name</Label>
        <Description>Host name of the appliance, e.g. ngcorion or ngcorion.corp.example</Description>
      </Property>
      <Category>Network (leave the address empty for DHCP)</Category>
      <Property ovf:key="ngcorion.ip" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
        <Label>IPv4 address with prefix</Label>
        <Description>e.g. 192.168.10.20/24. Empty: DHCP.</Description>
      </Property>
      <Property ovf:key="ngcorion.gateway" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
        <Label>Default gateway</Label>
        <Description>Required with a static address</Description>
      </Property>
      <Property ovf:key="ngcorion.dns" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
        <Label>DNS servers</Label>
        <Description>Comma-separated; required with a static address</Description>
      </Property>
      <Property ovf:key="ngcorion.ntp" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
        <Label>NTP servers</Label>
        <Description>Comma-separated host names or addresses. Empty: from DHCP or Ubuntu's pool.</Description>
      </Property>
      <Category>Access</Category>
      <Property ovf:key="ngcorion.admin_password" ovf:password="true" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
        <Label>Password of the web administrator 'admin'</Label>
        <Description>At least 12 characters with upper and lower case, a digit and a special character. Must be changed at the first login.</Description>
      </Property>
    </ProductSection>
    <VirtualHardwareSection ovf:transport="com.vmware.guestInfo">
      <Info>Virtual hardware requirements</Info>
      <System>
        <vssd:ElementName>Virtual Hardware Family</vssd:ElementName>
        <vssd:InstanceID>0</vssd:InstanceID>
        <vssd:VirtualSystemIdentifier>NGCorion-@VERSION@</vssd:VirtualSystemIdentifier>
        <!-- vmx-13 (ESXi 6.5): the oldest hardware with EFI Secure Boot; a newer family is refused by an
             older host ("Unsupported hardware family"), and the VM can be upgraded in place later -->
        <vssd:VirtualSystemType>vmx-13</vssd:VirtualSystemType>
      </System>
      <Item>
        <rasd:AllocationUnits>hertz * 10^6</rasd:AllocationUnits>
        <rasd:Description>Number of Virtual CPUs</rasd:Description>
        <rasd:ElementName>@CPUS@ virtual CPU(s)</rasd:ElementName>
        <rasd:InstanceID>1</rasd:InstanceID>
        <rasd:ResourceType>3</rasd:ResourceType>
        <rasd:VirtualQuantity>@CPUS@</rasd:VirtualQuantity>
      </Item>
      <Item>
        <rasd:AllocationUnits>byte * 2^20</rasd:AllocationUnits>
        <rasd:Description>Memory Size</rasd:Description>
        <rasd:ElementName>@MEMORY_MB@MB of memory</rasd:ElementName>
        <rasd:InstanceID>2</rasd:InstanceID>
        <rasd:ResourceType>4</rasd:ResourceType>
        <rasd:VirtualQuantity>@MEMORY_MB@</rasd:VirtualQuantity>
      </Item>
      <Item>
        <rasd:Address>0</rasd:Address>
        <rasd:Description>SCSI Controller</rasd:Description>
        <rasd:ElementName>SCSI Controller 0</rasd:ElementName>
        <rasd:InstanceID>3</rasd:InstanceID>
        <rasd:ResourceSubType>VirtualSCSI</rasd:ResourceSubType>
        <rasd:ResourceType>6</rasd:ResourceType>
      </Item>
      <Item>
        <rasd:AddressOnParent>0</rasd:AddressOnParent>
        <rasd:ElementName>Hard Disk 1</rasd:ElementName>
        <rasd:HostResource>ovf:/disk/vmdisk1</rasd:HostResource>
        <rasd:InstanceID>4</rasd:InstanceID>
        <rasd:Parent>3</rasd:Parent>
        <rasd:ResourceType>17</rasd:ResourceType>
      </Item>
      <Item>
        <rasd:AddressOnParent>7</rasd:AddressOnParent>
        <rasd:AutomaticAllocation>true</rasd:AutomaticAllocation>
        <rasd:Connection>Management</rasd:Connection>
        <rasd:Description>VmxNet3 ethernet adapter on "Management"</rasd:Description>
        <rasd:ElementName>Network adapter 1</rasd:ElementName>
        <rasd:InstanceID>5</rasd:InstanceID>
        <rasd:ResourceSubType>VmxNet3</rasd:ResourceSubType>
        <rasd:ResourceType>10</rasd:ResourceType>
      </Item>
      <Item ovf:required="false">
        <rasd:AutomaticAllocation>false</rasd:AutomaticAllocation>
        <rasd:ElementName>Video card</rasd:ElementName>
        <rasd:InstanceID>6</rasd:InstanceID>
        <rasd:ResourceType>24</rasd:ResourceType>
      </Item>
      <vmw:Config ovf:required="false" vmw:key="firmware" vmw:value="efi"/>
      <vmw:Config ovf:required="false" vmw:key="bootOptions.efiSecureBootEnabled" vmw:value="true"/>
      <vmw:Config ovf:required="false" vmw:key="tools.syncTimeWithHost" vmw:value="false"/>
      <vmw:Config ovf:required="false" vmw:key="powerOpInfo.powerOffType" vmw:value="soft"/>
      <vmw:Config ovf:required="false" vmw:key="powerOpInfo.rebootType" vmw:value="soft"/>
    </VirtualHardwareSection>
    <AnnotationSection>
      <Info>Description</Info>
      <Annotation>NGCorion @VERSION@. Open the console after power-on: the first-start setup runs there unless the deploy settings above were filled in.</Annotation>
    </AnnotationSection>
  </VirtualSystem>
</Envelope>
