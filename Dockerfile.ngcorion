# The frontend bundle is built here, inside the image build, so the backend
# image carries everything it serves: no host checkout, no host Node.js and no
# bind-mounted source at run time.
#
# Base images come from the Docker Hub mirror used for installations in Iran;
# elsewhere build with --build-arg BASE_REGISTRY=docker.io (CI does).
ARG BASE_REGISTRY=docker.arvancloud.ir

FROM ${BASE_REGISTRY}/node:22-slim AS frontend

# Optional npm mirror (e.g. --build-arg NPM_REGISTRY=https://...). npm swaps
# the registry host of the lockfile's registry.npmjs.org URLs for it.
ARG NPM_REGISTRY=
WORKDIR /front
COPY front/package.json front/package-lock.json ./
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi \
    && npm ci --no-audit --no-fund
COPY front/ ./
RUN npm run build

FROM ${BASE_REGISTRY}/python:3.13-slim AS base

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# Python package index for pip/uv. The default is the mirror used for
# installations in Iran; elsewhere: --build-arg PYPI_INDEX=https://pypi.org/simple
ARG PYPI_INDEX=https://mirror-pypi.runflare.com/simple
RUN pip install --no-cache-dir uv -i "$PYPI_INDEX"
# tzdata provides /usr/share/zoneinfo. Without it the image has no zone
# database at all, so the Time settings fall back to the /etc/localtime symlink
# and reject every zone ("not a known zone under /usr/share/zoneinfo") --
# there is no systemd in the container for timedatectl to reach either.
# Pango and HarfBuzz lay out the PDF reports (WeasyPrint); the fonts ship with
# the reports module, so no font packages are needed.
RUN apt-get update && apt-get install -y procps nmap tzdata libcap2-bin \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged runtime account (security checklist item 2.2). The container
# starts as root only so entrypoint.sh can hand the paths the app writes to
# this account, then drops to it before migrations and the server run.
#
# The two host operations that need privileges get exactly one capability
# each, as file capabilities, instead of a root process:
#   - nmap: CAP_NET_RAW for UDP discovery (in Docker's default set);
#     NMAP_PRIVILEGED tells nmap to use it.
#   - a dedicated copy of `date`: CAP_SYS_TIME for the manual-clock setting
#     (needs `cap_add: SYS_TIME`). The system `date` is left untouched so it
#     keeps working in a container started without that capability.
# The timezone fallback retargets a link inside /var/lib/ngcorion/tz, which
# /etc/localtime points at, so it needs no write access to /etc.
RUN groupadd -g 10001 ngcorion \
    && useradd -u 10001 -g 10001 -m -d /home/ngcorion -s /usr/sbin/nologin ngcorion \
    && setcap cap_net_raw+eip /usr/bin/nmap \
    && install -d /usr/local/lib/ngcorion \
    && cp /usr/bin/date /usr/local/lib/ngcorion/date \
    && setcap cap_sys_time+ep /usr/local/lib/ngcorion/date \
    && mkdir -p /var/lib/ngcorion/license /var/lib/ngcorion/tz /var/lib/ngcorion/backups \
    && ln -sf /usr/share/zoneinfo/Etc/UTC /var/lib/ngcorion/tz/localtime \
    && ln -sf /var/lib/ngcorion/tz/localtime /etc/localtime \
    && chown -R 10001:10001 /var/lib/ngcorion

ENV NMAP_PRIVILEGED=1 \
    NGCORION_DATE_CMD=/usr/local/lib/ngcorion/date \
    NGCORION_LOCALTIME_LINK=/var/lib/ngcorion/tz/localtime

FROM base AS development

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project -i "$PYPI_INDEX"

COPY . .
RUN uv sync --frozen -i "$PYPI_INDEX"

COPY --from=frontend /front/dist /app/front/dist

EXPOSE 8000

# Run `alembic upgrade head` before the server starts (see entrypoint.sh).
RUN chmod +x /app/entrypoint.sh

# Development only (docker-compose.dev.yml bind-mounts the source over the
# baked copy): `uv run` re-syncs the virtualenv when pyproject.toml/uv.lock
# change, so the venv is writable here. Source files stay root-owned.
RUN chown -R 10001:10001 /app/.venv

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

FROM base AS production

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project -i "$PYPI_INDEX"

COPY . .
RUN uv sync --frozen --no-dev -i "$PYPI_INDEX" \
    && python -m compileall -q app alembic scripts \
    && rm -rf front
COPY --from=frontend /front/dist /app/front/dist

ARG NGCORION_VERSION=dev
LABEL org.opencontainers.image.title="NGCorion" \
      org.opencontainers.image.version="$NGCORION_VERSION"

EXPOSE 8000

# Run `alembic upgrade head` before the server starts (see entrypoint.sh).
RUN chmod +x /app/entrypoint.sh

# Everything under /app - code, virtualenv, frontend bundle - is baked into the
# image and stays root-owned: the app (UID 10001) can read and run it, never
# change it. What it does write lives in volumes (license, backups) and in the
# host configuration paths entrypoint.sh hands over. The server is started
# from the virtualenv directly; `uv run` would try to re-sync it.
#
# --timeout-worker-healthcheck: uvicorn's supervisor kills a worker that does
# not answer its ping within 5 seconds (the default). Importing the app takes
# longer than that on a slow or busy VM, so every worker was killed while
# starting, in a loop, and the server never came up (found on the appliance).
# Two minutes still replaces a hung worker.
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--timeout-worker-healthcheck", "120"]
