# ---------------------------------------------------------------------------
# .env for the standalone license server host (deploy/docker-compose.license.yml)
# Copy to /opt/ngcorion-license/.env and fill in. chmod 600.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Keep name/user identical to the source deployment so the pg_dump restores
# cleanly without rewriting ownership.
LICENSE_DB_NAME=license_db
LICENSE_DB_USER=license_user
# REQUIRED. If you are restoring an existing dump, this must match the password
# the dump's role expects, or set a new one and ALTER USER after the restore.
LICENSE_DB_PASSWORD=

# --- License server -------------------------------------------------------
# REQUIRED. Signs the license-admin JWTs.
# MIGRATION: use the SAME value as the old deployment (docker-compose.yml ->
# license-server -> SECRET_KEY). A new value only invalidates admin sessions —
# it does NOT affect app<->license-server calls, which are signed per license
# with the organization_token.
# New installation: openssl rand -hex 32
LICENSE_SERVER_SECRET_KEY=

# HTTP Basic credentials for the admin API / license-admin UI. REQUIRED.
LICENSE_ADMIN_USERNAME=admin
LICENSE_ADMIN_PASSWORD=

# Requests per minute per client IP. After the split, ALL app traffic arrives
# from a single source IP, so this limit now applies to the whole app server at
# once — raise it if the app polls /api/license/status frequently.
LICENSE_RATE_LIMIT_PER_MINUTE=60

# Redis DB index used for rate-limit counters (dedicated instance here).
LICENSE_REDIS_DB=1

# --- Networking -----------------------------------------------------------
# Interface to publish port 8001 on. Prefer the private/management address the
# app server uses; 0.0.0.0 exposes the license API on every interface.
LICENSE_BIND_ADDR=0.0.0.0

# Only used by the optional `tls` profile (Traefik).
LICENSE_HOSTNAME=license.ngcorion.local
